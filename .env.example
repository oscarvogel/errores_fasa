# Aplicación
APP_NAME=FASA Error Monitor
APP_ENV=production
APP_PORT=8088
CORS_ORIGINS=http://localhost:5173,http://localhost:8088

# MySQL FASA (usar usuario de SOLO LECTURA)
DB_HOST=192.168.0.10
DB_PORT=3306
DB_NAME=fasa
DB_USER=error_dashboard
DB_PASSWORD=cambiar_esta_clave
DB_CHARSET=utf8mb4

# Tabla existente de errores
ERROR_TABLE=sys_errores
ERROR_ID_COLUMN=id

# Zona horaria mostrada por el frontend
TZ=America/Argentina/Buenos_Aires

# Aplicación
APP_NAME=FASA Error Monitor
APP_ENV=production
APP_PORT=8088
CORS_ORIGINS=http://localhost:5173,http://localhost:8088

# MySQL FASA central (usuario de SOLO LECTURA)
DB_HOST=192.168.0.10
DB_PORT=3306
DB_NAME=fasa
DB_USER=error_dashboard
DB_PASSWORD=cambiar_esta_clave
DB_CHARSET=utf8mb4

# Tablas centrales
ERROR_TABLE=sys_errores
ERROR_ID_COLUMN=id_error
BRANCHES_TABLE=sucursales

# MySQL de sucursales remotas
# El host y puerto de cada sucursal se leen desde la tabla `sucursales`.
# Estas credenciales deben existir con SELECT sobre sys_errores en cada sucursal.
REMOTE_DB_NAME=fasa
REMOTE_DB_USER=error_dashboard
REMOTE_DB_PASSWORD=cambiar_clave_remota
REMOTE_DB_CHARSET=utf8mb4
REMOTE_ERROR_TABLE=sys_errores
REMOTE_CONNECT_TIMEOUT=8
SYNC_BATCH_SIZE=1000

# Cache local persistente para errores sincronizados desde sucursales.
# No requiere permisos de escritura sobre el MySQL central.
SYNC_DB_PATH=/data/sync.db

# Zona horaria mostrada por el frontend
TZ=America/Argentina/Buenos_Aires
